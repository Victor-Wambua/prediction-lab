# Copy to .env and edit. Nothing here is a credential: log in manually in the browser.
AVIATOR_URL=https://www.betika.com/en-ke/aviator
# CSS selector matching each multiplier item in the round-history strip.
# Leave empty to auto-discover (run `python -m aviator_lab probe` to find one).
AVIATOR_HISTORY_ITEM_SELECTOR=
AVIATOR_DB_PATH=data/aviator.db
AVIATOR_POLL_SECONDS=1.0
