# Copy to .env and edit. Nothing here is a credential: log in manually in the browser.
PREDICTION_LAB_URL=https://example.com/game
# CSS selector matching each multiplier item in the round-history strip.
# Leave empty to auto-discover (run `python -m prediction_lab probe` to find one).
PREDICTION_LAB_HISTORY_ITEM_SELECTOR=
PREDICTION_LAB_DB_PATH=data/prediction_lab.db
PREDICTION_LAB_POLL_SECONDS=1.0
